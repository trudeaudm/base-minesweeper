# ── Network ───────────────────────────────────────────────────
# 84532 = Base Sepolia  |  8453 = Base mainnet
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# ── Relayer wallet ────────────────────────────────────────────
# EOA that pays gas for session-key funding transactions.
# Keep this wallet topped up with a small amount of ETH.
RELAYER_PRIVATE_KEY=0x...

# ── Contract ──────────────────────────────────────────────────
CONTRACT_ADDRESS=0xE2e2823454e331795E044CE4D81C49B51c3805Be

# ── Funding amount per game ───────────────────────────────────
# ETH sent to each session key. On Base this covers hundreds of
# tile flips. 0.0001 ETH ≈ $0.25 at $2500/ETH.
FUND_AMOUNT_ETH=0.0001

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:5173

# ── Server ────────────────────────────────────────────────────
PORT=3001
