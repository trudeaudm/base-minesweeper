# ── Contract ─────────────────────────────────────────────────
# Deployed Minesweeper contract address on Base Sepolia (or Base mainnet)
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ── Chain ─────────────────────────────────────────────────────
# 84532 = Base Sepolia (testnet)  |  8453 = Base (mainnet)
VITE_CHAIN_ID=84532

# ── WalletConnect ─────────────────────────────────────────────
# Get a project ID at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# ── RPC ───────────────────────────────────────────────────────────────────
# Custom JSON-RPC endpoint for the active chain.
# Required in production — the public sepolia.base.org endpoint 403s browser
# requests.  Use Alchemy, QuickNode, Infura, or Tenderly.
# Both wagmi contract reads AND the session-key viem client use this URL.
VITE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
